# Copy to .env and adjust. Every value has a working default for `docker compose up`.

# Postgres
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint
DB_PORT=5432

# App
APP_PORT=3000
JWT_SECRET=change-me-in-production-please
# Delivery date the seeded demo day runs on (must exist in calendar.csv).
DEMO_DATE=2026-04-29
# Show the dispatcher's "Reset demo day" control.
DEMO_CONTROLS=true

# Local development only (npm run dev:api reads this file)
DATABASE_URL=postgres://waypoint:waypoint@localhost:5432/waypoint
DATA_DIR=../../data

# Production HTTPS (docker compose --profile prod up -d): your domain, or <server-ip>.sslip.io
SITE_ADDRESS=localhost
