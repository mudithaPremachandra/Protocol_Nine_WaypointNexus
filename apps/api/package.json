    "seed": "tsx --env-file=../../.env src/db/seed/run.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.1",
